# Env example

## Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

## Provider settings

### OpenRouter (default)

LLM_PROVIDER=openrouter
EMBEDDINGS_PROVIDER=openrouter # Set to local to use local RAG

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_preferred_model

### MLX (local development only — uncomment to use instead of OpenRouter)

# LLM_PROVIDER=mlx
# EMBEDDINGS_PROVIDER=local
# MLX_BASE_URL=http://localhost:8000/v1
# MLX_MODEL=your_model_name_here
# MLX_API_KEY=

## Test

# SHREK=true  # shows test-only parties, defaults to false
