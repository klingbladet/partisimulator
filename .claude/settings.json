{
  "allowedHttpHookUrls": [],
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoUploadSessions": false,
  "cleanupPeriodDays": 1,
  "crossSessionInbound": "hold",
  "disableRemoteControl": true,
  "disableSkillShellExecution": true,
  "effortLevel": "high",
  "enableAllProjectMcpServers": false,
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SKIP_PROMPT_HISTORY": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_UPDATES": "1",
    "DO_NOT_TRACK": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-format-code.mjs\"",
            "type": "command"
          },
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-format-markdown.mjs\"",
            "type": "command"
          },
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/spellcheck.mjs\"",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ]
  },
  "httpHookAllowedEnvVars": [],
  "includeGitInstructions": false,
  "isolatePeerMachines": true,
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cd)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git describe:*)",
      "Bash(git rev-parse:*)",
      "Bash(git shortlog:*)",
      "Bash(git cat-file:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git name-rev:*)",
      "Bash(git check-ignore:*)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Write",
      "Edit"
    ],
    "ask": [
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "WebFetch",
      "WebSearch",
      "Read(**/.*)",
      "Edit(**/.*)",
      "Read(**/.*/**)",
      "Edit(**/.*/**)",
      "Bash(python*)",
      "Bash(*/python*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(docker:*)",
      "Bash(orb:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Bash(su *)",
      "Bash(sh:*)",
      "Bash(bash:*)",
      "Bash(zsh:*)",
      "Bash(eval:*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/.ssh*)",
      "Edit(**/.ssh*)",
      "Bash(ssh:*)",
      "Bash(git push -f *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git clean -f *)",
      "Bash(rsync:*)",
      "Bash(screencapture:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",
      "Bash(ftps:*)",
      "Bash(osascript:*)",
      "Bash(xattr:*)",
      "Bash(diskutil:*)",
      "Bash(launchctl:*)",
      "Bash(crontab:*)",
      "Bash(defaults:*)",
      "Bash(security:*)",
      "Bash(reboot:*)",
      "Bash(http:*)",
      "Bash(https:*)",
      "Bash(dig:*)",
      "Bash(nslookup:*)",
      "Bash(host:*)",
      "Edit(**/.zshrc)",
      "Edit(**/.zprofile)",
      "Edit(**/.bash_profile)",
      "Edit(**/.bashrc)",
      "Edit(**/Library/LaunchAgents/**)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(npq:*)",
      "Bash(pnpx:*)",
      "Bash(yarn:*)",
      "Bash(pip*)",
      "Bash(*/pip*)",
      "Bash(uv*)",
      "Bash(uvx*)",
      "Bash(*/uv*)",
      "Bash(*/uvx*)",
      "Bash(brew:*)",
      "Bash(bun:*)",
      "Edit(~/.claude/settings.json)",
      "Bash(openssl:*)",
      "Bash(dd:*)",
      "Bash(mkfs*)",
      "Bash(shutdown:*)",
      "Bash(halt:*)",
      "Bash(poweroff:*)",
      "Bash(csrutil:*)",
      "Bash(spctl:*)",
      "Bash(dscl:*)",
      "Bash(gh:*)"
    ],
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "GITHUB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GH_TOKEN"
        }
      ],
      "files": [
        {
          "mode": "deny",
          "path": "~/.git-credentials"
        },
        {
          "mode": "deny",
          "path": "~/.pgpass"
        }
      ]
    },
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "/tmp"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.bash_history",
        "~/.zsh_history",
        "~/.npmrc",
        "~/.config/gh/hosts.yml"
      ],
      "denyWrite": [
        "~/.claude/settings.json"
      ]
    },
    "network": {
      "allowedDomains": [],
      "allowLocalBinding": false
    }
  },
  "skipWebFetchPreflight": true
}
